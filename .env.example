# Copy to .env and fill in. Never commit .env.
# Create a key at https://openrouter.ai/settings/keys
#
# IMPORTANT: this key is shared by every visitor of the Prompt Lab. Before adding any credits
# to the account, attach an OpenRouter Guardrail to this key that only allows free models
# and has a small budget (see PROMPT-LAB.md). A credit limit alone caps the loss but does
# NOT restrict the key to free models.
OPENROUTER_API_KEY=sk-or-v1-...

# Optional class access code (letters and digits; not case-sensitive). When set, students
# must type it in the playground settings before they can send prompts. Leave empty to
# keep the playground open to everyone.
LAB_ACCESS_CODE=
