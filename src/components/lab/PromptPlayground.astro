---
// Prompt Lab, Section 2: the playground.
// Three windows: prompt editor (left), AI result (right), analysis (bottom, full width).
// All network calls go through src/lib/openrouter.ts. Model text is always escaped
// before rendering (see renderModelText), never injected as raw HTML.
import { checklist } from '../../data/prompt-lab';
import { playgroundPresets } from '../../data/playground-presets';
import { DEFAULT_MODEL, DEFAULT_TEMPERATURE } from '../../lib/openrouter';

const presetGroups = checklist.map((item) => ({
  item,
  presets: playgroundPresets
    .filter((p) => p.element === item.key)
    .sort((a, b) => (a.kind === b.kind ? 0 : a.kind === 'bad' ? -1 : 1)),
}));
---

<div class="pg" data-playground>
  <details class="pg-settings">
    <summary>ตั้งค่า (รหัสคลาส, โมเดล, temperature, คีย์ของคุณเอง)</summary>
    <div class="pg-settings-body">
      <p class="pg-note">
        โดยปกติคำขอทั้งหมดจะส่งผ่าน<strong>เซิร์ฟเวอร์ของเว็บนี้</strong> ซึ่งใส่คีย์ OpenRouter ให้เอง
        คุณจึง<strong>ไม่ต้องมีคีย์</strong>ก็ใช้งานได้ แต่คีย์ของเว็บใช้ร่วมกันทุกคนและใช้โมเดลฟรีซึ่งมีโควตาจำกัด
        ถ้าโควตาเต็มบ่อย ใส่คีย์ OpenRouter ของคุณเองด้านล่างได้
      </p>

      <div class="pg-field">
        <label for="pg-labcode">รหัสคลาส (ถ้าผู้สอนกำหนด)</label>
        <div class="pg-inline">
          <input id="pg-labcode" type="text" spellcheck="false" autocomplete="off" autocapitalize="off" aria-describedby="pg-labcode-hint pg-labcode-status" />
        </div>
        <p id="pg-labcode-hint" class="pg-hint">
          ถ้าผู้สอนให้รหัสคลาสมา ใส่ที่นี่ก่อนส่ง Prompt ระบบจะจำไว้ในเบราว์เซอร์นี้ (localStorage)
          และส่งไปกับคำขอที่ผ่านเซิร์ฟเวอร์ของเว็บเท่านั้น ไม่ส่งไปที่ openrouter.ai ถ้าผู้สอนไม่ได้กำหนด ปล่อยว่างไว้ได้
        </p>
        <p id="pg-labcode-status" class="pg-hint pg-problem" aria-live="polite"></p>
      </div>

      <div class="pg-field">
        <label for="pg-model">Model id</label>
        <div class="pg-inline">
          <input id="pg-model" type="text" spellcheck="false" autocomplete="off" placeholder={DEFAULT_MODEL} value={DEFAULT_MODEL} aria-describedby="pg-model-hint pg-model-status" />
          <button type="button" class="lab-btn secondary" data-action="reset-model">ใช้ค่าเริ่มต้น</button>
        </div>
        <p id="pg-model-hint" class="pg-hint">
          ค่าเริ่มต้น <code>{DEFAULT_MODEL}</code> ให้ OpenRouter เลือกโมเดลฟรีที่ว่างอยู่ให้อัตโนมัติ
          ถ้าจะระบุเอง model id ที่ลงท้ายด้วย <code>:free</code> คือโมเดลฟรี
          ซึ่งเป็นโมเดลเดียวที่ใช้ได้บนคีย์ของเว็บ (โมเดลอื่นต้องใส่คีย์ของคุณเอง)
          (ดูรายชื่อได้ที่ <a href="https://openrouter.ai/models?max_price=0" target="_blank" rel="noopener noreferrer">openrouter.ai/models</a>)
        </p>
        <p id="pg-model-status" class="pg-hint pg-problem" aria-live="polite"></p>
      </div>

      <div class="pg-field">
        <label for="pg-temp">Temperature</label>
        <div class="pg-inline">
          <input id="pg-temp" type="range" min="0" max="2" step="0.1" value={DEFAULT_TEMPERATURE} aria-describedby="pg-temp-hint" />
          <output id="pg-temp-out" for="pg-temp">{DEFAULT_TEMPERATURE.toFixed(1)}</output>
        </div>
        <p id="pg-temp-hint" class="pg-hint">
          ค่าต่ำ (0–0.3) ตอบคงที่และตรงไปตรงมา ค่าสูง (1 ขึ้นไป) สร้างสรรค์และสุ่มมากขึ้น ค่าเริ่มต้นคือ {DEFAULT_TEMPERATURE}
        </p>
      </div>

      <div class="pg-field">
        <label for="pg-key">คีย์ OpenRouter ของคุณเอง (ไม่บังคับ)</label>
        <div class="pg-inline">
          <input id="pg-key" type="password" spellcheck="false" autocomplete="off" placeholder="sk-or-v1-..." aria-describedby="pg-key-hint pg-key-status" />
          <button type="button" class="lab-btn secondary" data-action="save-key">บันทึกคีย์</button>
          <button type="button" class="lab-btn secondary" data-action="clear-key">ลบคีย์</button>
        </div>
        <p id="pg-key-hint" class="pg-hint">
          คีย์จะถูกเก็บไว้<strong>ในเบราว์เซอร์ของคุณเท่านั้น</strong> (localStorage) และส่งตรงไปที่ openrouter.ai
          ไม่ผ่านเซิร์ฟเวอร์ของเว็บนี้ ถ้าใช้คอมพิวเตอร์ส่วนรวม กด "ลบคีย์" ทุกครั้งหลังใช้งาน
        </p>
        <p id="pg-key-status" class="pg-hint pg-key-status" aria-live="polite">กำลังใช้: เซิร์ฟเวอร์ของเว็บ (ไม่ต้องมีคีย์)</p>
      </div>
    </div>
  </details>

  <div class="pg-windows">
    <section class="pg-window pg-editor" aria-labelledby="pg-editor-title">
      <header class="pg-bar">
        <h2 id="pg-editor-title">Prompt ของคุณ</h2>
        <span class="pg-count" data-el="count">0 ตัวอักษร · 0 คำ</span>
      </header>
      <div class="pg-body">
        <div class="pg-field">
          <label for="pg-preset">ลองจากตัวอย่าง</label>
          <select id="pg-preset">
            <option value="">— เลือก Prompt ตัวอย่าง (แบบไม่ดี / แบบดี) —</option>
            {presetGroups.map(({ item, presets }) => (
              <optgroup label={`${item.th} (${item.en})`}>
                {presets.map((p) => (
                  <option value={p.id}>{p.kind === 'bad' ? 'แบบไม่ดี' : 'แบบดี'}: {p.title}</option>
                ))}
              </optgroup>
            ))}
          </select>
        </div>

        <div class="pg-field pg-grow">
          <label for="pg-prompt" class="pg-sr-only">Prompt</label>
          <textarea
            id="pg-prompt"
            spellcheck="false"
            rows="14"
            placeholder="พิมพ์ Prompt ที่นี่ (ภาษาไหนก็ได้) หรือเลือกจาก &quot;ลองจากตัวอย่าง&quot; ด้านบน"
            aria-describedby="pg-shortcut"
          ></textarea>
        </div>

        <div class="pg-actions">
          <button type="button" class="lab-btn" data-action="submit">ส่ง Prompt</button>
          <button type="button" class="lab-btn secondary" data-action="clear">ล้าง</button>
          <span id="pg-shortcut" class="pg-hint">กด Ctrl + Enter (Mac: ⌘ + Enter) เพื่อส่ง</span>
        </div>
        <p class="pg-hint pg-editor-status" data-el="editor-status" aria-live="polite"></p>
      </div>
    </section>

    <section class="pg-window pg-result" aria-labelledby="pg-result-title">
      <header class="pg-bar">
        <h2 id="pg-result-title">ผลลัพธ์จาก AI</h2>
        <span class="pg-count" data-el="result-round"></span>
      </header>
      <div class="pg-body">
        <p class="pg-status" data-el="result-status" role="status" aria-live="polite"></p>
        <div class="pg-error" data-el="result-error" hidden>
          <p class="pg-error-msg" data-el="result-error-msg"></p>
          <p class="pg-error-detail" data-el="result-error-detail" hidden></p>
          <div class="pg-actions">
            <button type="button" class="lab-btn secondary" data-action="retry">ลองอีกครั้ง</button>
          </div>
        </div>
        <div class="pg-output" data-el="result-output">
          <p class="pg-placeholder">ผลลัพธ์จะแสดงที่นี่หลังจากกด "ส่ง Prompt"</p>
        </div>
        <p class="pg-trunc" data-el="result-trunc" hidden>
          คำตอบนี้ถูกตัดกลางคันเพราะยาวเกินลิมิตโทเคนของสนามทดลอง ลองขอให้ AI ตอบสั้นลง หรือกำหนดความยาวใน Prompt
        </p>
        <div class="pg-actions" data-el="result-cancel" hidden>
          <button type="button" class="lab-btn secondary" data-action="cancel">ยกเลิก</button>
        </div>
        <p class="pg-meta" data-el="result-meta" hidden></p>
      </div>
    </section>

    <section class="pg-history-strip" aria-labelledby="pg-history-title">
      <h2 id="pg-history-title" class="pg-history-title">ประวัติการทดลอง</h2>
      <ol class="pg-history" data-el="history"></ol>
      <p class="pg-hint" data-el="history-empty">
        ยังไม่มีการทดลอง ส่ง Prompt แล้วคะแนนของแต่ละรอบจะแสดงที่นี่เพื่อเปรียบเทียบ (เก็บ 5 รอบล่าสุด เฉพาะในหน้านี้ รีเฟรชแล้วจะหายไป)
      </p>
    </section>

    <section class="pg-window pg-analysis" aria-labelledby="pg-analysis-title">
      <header class="pg-bar">
        <h2 id="pg-analysis-title">วิเคราะห์ Prompt และผลลัพธ์</h2>
      </header>
      <div class="pg-body pg-analysis-grid">
        <section class="pg-local" aria-labelledby="pg-local-title">
          <h3 id="pg-local-title">ตรวจเบื้องต้น (ทันที)</h3>
          <p class="pg-hint">
            ตรวจจากคำสำคัญใน Prompt ที่กำลังพิมพ์ ไม่ได้ส่งไปหา AI เป็น<strong>แนวทางคร่าว ๆ</strong>เท่านั้น
            ไม่ใช่ทุกงานต้องมีครบ 8 ข้อ
          </p>
          <p class="pg-local-summary" data-el="local-summary"></p>
          <ul class="pg-local-list" data-el="local-list"></ul>
        </section>

        <section class="pg-coach" aria-labelledby="pg-coach-title">
          <div class="pg-coach-head">
            <h3 id="pg-coach-title">AI Coach (วิเคราะห์ละเอียด)</h3>
            <div class="pg-inline pg-coach-controls">
              <label class="pg-check">
                <input type="checkbox" id="pg-auto" checked />
                ให้ AI Coach วิเคราะห์อัตโนมัติ
              </label>
              <button type="button" class="lab-btn secondary" data-action="coach" disabled>วิเคราะห์</button>
            </div>
          </div>
          <p class="pg-hint">
            หลังได้ผลลัพธ์ AI Coach จะส่ง Prompt และผลลัพธ์ของคุณไปให้ AI อีกครั้งเพื่อให้คะแนนตาม 8 องค์ประกอบ (0–2 คะแนนต่อข้อ)
            ทุกครั้งที่วิเคราะห์ใช้โควตาเพิ่มอีก 1 คำขอ ปิดการวิเคราะห์อัตโนมัติได้ถ้าอยากประหยัดโควตา
          </p>
          <p class="pg-status" data-el="coach-status" role="status" aria-live="polite"></p>
          <div class="pg-error" data-el="coach-error" hidden>
            <p class="pg-error-msg" data-el="coach-error-msg"></p>
            <p class="pg-error-detail" data-el="coach-error-detail" hidden></p>
          </div>
          <div class="pg-coach-out" data-el="coach-output">
            <p class="pg-placeholder">ยังไม่มีการวิเคราะห์</p>
          </div>
        </section>
      </div>
    </section>
  </div>
</div>

<style>
  /* Scoped to .pg. Content created at runtime (innerHTML) is reached via :global(). */
  .pg {
    margin: 1.25rem 0 2rem;
  }

  .pg :global(:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .pg :global(.pg-sr-only) {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .pg :global(code) {
    font-family: var(--mono);
    font-size: 0.88em;
    padding: 0 0.25em;
    background: var(--code-bg);
    border: 1px solid var(--border-soft);
  }

  /* --- Settings --- */
  .pg-settings {
    margin-bottom: 1rem;
    border: 1px solid var(--border);
    background: var(--panel-bg);
  }

  .pg-settings > summary {
    padding: 0.5rem 0.85rem;
    background: var(--sidebar-bg);
    font-weight: 600;
    cursor: pointer;
  }

  .pg-settings[open] > summary {
    border-bottom: 1px solid var(--border);
  }

  .pg-settings-body {
    padding: 0.85rem;
  }

  .pg-note {
    margin: 0 0 0.85rem;
    padding: 0.6rem 0.85rem;
    border-left: 3px solid var(--accent);
    background: var(--sidebar-bg);
    font-size: 0.92rem;
  }

  .pg-field {
    margin-bottom: 0.75rem;
  }

  .pg-field > label {
    display: block;
    margin-bottom: 0.25rem;
    font-weight: 600;
    font-size: 0.92rem;
  }

  .pg-inline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  input[type='text'],
  input[type='password'],
  select,
  textarea {
    font: inherit;
    font-size: 0.95rem;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 0;
    padding: 0.4rem 0.55rem;
  }

  input[type='text'],
  input[type='password'] {
    flex: 1 1 16rem;
    min-width: 0;
    font-family: var(--mono);
    font-size: 0.88rem;
  }

  input[type='range'] {
    flex: 0 1 16rem;
  }

  output {
    min-width: 2.5rem;
    font-family: var(--mono);
    font-weight: 600;
  }

  select {
    width: 100%;
  }

  .pg :global(.pg-hint) {
    margin: 0.3rem 0 0;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .pg-key-status {
    color: var(--text);
    font-weight: 600;
  }

  /* --- Windows --- */
  .pg-windows {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-areas:
      'editor result'
      'history history'
      'analysis analysis';
    gap: 1rem;
  }

  .pg-editor { grid-area: editor; }
  .pg-result { grid-area: result; }
  .pg-history-strip { grid-area: history; }
  .pg-analysis { grid-area: analysis; }

  .pg-window {
    display: flex;
    flex-direction: column;
    min-width: 0;
    border: 1px solid var(--border);
    background: var(--panel-bg);
  }

  .pg-bar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.45rem 0.85rem;
    border-bottom: 1px solid var(--border);
    background: var(--sidebar-bg);
  }

  .pg-bar h2 {
    margin: 0;
    font-size: 1rem;
    line-height: 1.4;
  }

  .pg-count {
    color: var(--muted);
    font-size: 0.82rem;
    white-space: nowrap;
  }

  .pg-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    padding: 0.85rem;
  }

  .pg-grow {
    display: flex;
    flex: 1;
    flex-direction: column;
  }

  textarea {
    flex: 1;
    width: 100%;
    min-height: 18rem;
    resize: vertical;
    font-family: var(--mono);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .pg :global(.pg-actions) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.6rem;
  }

  .pg :global(.pg-actions[hidden]) {
    display: none;
  }

  .pg-editor-status:empty {
    display: none;
  }

  /* Status lines and problem lines stay rendered (no display toggling) so screen readers
     announce their text reliably when it changes. */
  .pg-status:empty,
  .pg-status.is-empty {
    margin: 0;
  }

  .pg :global(.pg-problem) {
    color: var(--bad);
    font-weight: 600;
  }

  .pg :global(.pg-problem:empty) {
    margin: 0;
  }

  .pg :global(.pg-trunc) {
    margin: 0.5rem 0 0;
    padding: 0.4rem 0.6rem;
    border-left: 3px solid var(--warn);
    background: var(--warn-bg);
    font-size: 0.85rem;
  }

  .pg :global(.pg-trunc[hidden]) {
    display: none;
  }

  .pg-status {
    margin: 0 0 0.6rem;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .pg-status.is-loading::before {
    content: '';
    display: inline-block;
    width: 0.7em;
    height: 0.7em;
    margin-right: 0.45em;
    border: 2px solid var(--border);
    border-top-color: var(--accent);
    border-radius: 50%;
    vertical-align: -0.05em;
    animation: pg-spin 0.8s linear infinite;
  }

  @keyframes pg-spin {
    to { transform: rotate(360deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .pg-status.is-loading::before { animation: none; }
  }

  .pg :global(.pg-placeholder) {
    margin: 0;
    color: var(--muted);
    font-style: italic;
  }

  /* Model output: escaped text with a tiny markdown subset. */
  .pg-output {
    flex: 1;
    min-height: 18rem;
    max-height: 34rem;
    overflow: auto;
    padding: 0.75rem 0.85rem;
    border: 1px solid var(--border-soft);
    background: var(--bg);
    font-size: 0.95rem;
    overflow-wrap: anywhere;
  }

  .pg-output :global(p),
  .pg :global(.pg-coach-text p) {
    margin: 0 0 0.7rem;
  }

  .pg-output :global(ul),
  .pg-output :global(ol),
  .pg :global(.pg-coach-text ul),
  .pg :global(.pg-coach-text ol) {
    margin: 0 0 0.7rem;
    padding-left: 1.4rem;
  }

  .pg-output :global(pre),
  .pg :global(.pg-coach-text pre) {
    margin: 0 0 0.7rem;
    padding: 0.6rem 0.75rem;
    overflow-x: auto;
    border: 1px solid var(--border-soft);
    background: var(--code-bg);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .pg :global(pre code) {
    padding: 0;
    border: 0;
    background: none;
    white-space: pre;
  }

  .pg-output > :global(:last-child) {
    margin-bottom: 0;
  }

  .pg :global(.pg-meta) {
    margin: 0.5rem 0 0;
    color: var(--muted);
    font-size: 0.82rem;
    overflow-wrap: anywhere;
  }

  .pg :global(.pg-meta code) {
    color: var(--text);
  }

  .pg-error {
    margin: 0 0 0.75rem;
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--bad-border);
    border-left: 3px solid var(--bad);
    background: var(--bad-bg);
  }

  .pg-error[hidden] {
    display: none;
  }

  .pg-error-msg {
    margin: 0;
  }

  .pg-error-detail {
    margin: 0.35rem 0 0;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.78rem;
    overflow-wrap: anywhere;
  }

  .pg-error .pg-actions {
    margin-top: 0.5rem;
  }

  /* --- History --- */
  .pg-history-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    padding: 0.55rem 0.85rem;
    border: 1px solid var(--border);
    background: var(--sidebar-bg);
  }

  .pg-history-title {
    margin: 0;
    font-size: 0.92rem;
  }

  .pg-history-strip .pg-hint {
    margin: 0;
  }

  .pg-history {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pg-history:empty {
    display: none;
  }

  .pg-history :global(li) {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .pg-history :global(li + li)::before {
    content: '→';
    color: var(--muted);
  }

  .pg-history :global(button) {
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--text);
    font: inherit;
    font-size: 0.88rem;
    cursor: pointer;
  }

  .pg-history :global(button:hover) {
    border-color: var(--accent);
  }

  .pg-history :global(button[aria-current='true']) {
