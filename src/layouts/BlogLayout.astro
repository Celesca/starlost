---
import '../../styles.css';

const { frontmatter } = Astro.props;
const dateFormatter = new Intl.DateTimeFormat('en', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{frontmatter.title} | StarLost</title>
  </head>
  <body>
    <div class="page-shell">
      <header class="topbar">
        <a class="brand" href="/">StarLost</a>
        <nav class="site-nav" aria-label="Primary">
          <a href="/">Home</a>
          <a href="/posts/hello-ai">Latest post</a>
        </nav>
      </header>

      <main class="article-wrap">
        <article class="article-shell">
          <div class="article-meta-row">
            <span class="pill">Post</span>
            <time datetime={frontmatter.date.toISOString()}>{dateFormatter.format(frontmatter.date)}</time>
          </div>
          <h1 class="article-title">{frontmatter.title}</h1>
          <p class="article-summary">{frontmatter.description}</p>
          <div class="article-body">
            <slot />
          </div>
        </article>
      </main>
    </div>
  </body>
</html>
