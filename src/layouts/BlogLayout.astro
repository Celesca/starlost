---
const { frontmatter } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{frontmatter.title} | StarLost</title>
    <style>
      :root {
        color-scheme: dark;
        --bg: #07111f;
        --surface: #101b2d;
        --text: #f4f7fb;
        --muted: #98a8bf;
        --accent: #7dd3fc;
      }
      body {
        margin: 0;
        font-family: Inter, "Segoe UI", sans-serif;
        background: linear-gradient(135deg, var(--bg), #0f172a 70%);
        color: var(--text);
        line-height: 1.7;
      }
      main {
        width: min(860px, calc(100% - 2rem));
        margin: 0 auto;
        padding: 3rem 0 4rem;
      }
      a { color: var(--accent); }
      .meta { color: var(--muted); margin-bottom: 1rem; }
      article { background: var(--surface); border: 1px solid rgba(255,255,255,0.08); border-radius: 1rem; padding: 2rem; }
    </style>
  </head>
  <body>
    <main>
      <article>
        <p class="meta">{frontmatter.date}</p>
        <h1>{frontmatter.title}</h1>
        <slot />
      </article>
    </main>
  </body>
</html>
