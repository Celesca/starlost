---
import { getCollection } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';
import { buildWikiSidebarItems, pathFromEntry } from '../lib/wiki-tree';

const posts = await getCollection('posts');
const sidebarItems = buildWikiSidebarItems(posts);
const recentPosts = [...posts].sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const dateFormatter = new Intl.DateTimeFormat('en', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});
---

<BlogLayout pageTitle="Home" sidebarItems={sidebarItems}>
  <article class="wiki-page">
    <p class="page-kicker">Home</p>
    <h1>Minimal notes, organized by folder.</h1>
    <p class="page-summary">
      Use the sidebar on the left to move through the folder tree. A folder can have an index page and any number of nested Markdown pages beneath it.
    </p>

    <section class="panel">
      <h2>Recent pages</h2>
      <ul class="page-list">
        {recentPosts.map((post) => (
          <li class="page-list-item">
            <a href={`/posts/${pathFromEntry(post)}`}>{post.data.title}</a>
            <div class="page-list-meta">
              <time datetime={post.data.date.toISOString()}>{dateFormatter.format(post.data.date)}</time>
            </div>
            <p>{post.data.description}</p>
          </li>
        ))}
      </ul>
    </section>
  </article>
</BlogLayout>
